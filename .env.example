# Copy to .env. Never commit .env.

# claude = real agents, sim = fake activity. Empty (the default): claude when a key is set, or when
# "Run desks on my Claude login" is on, on HQ's Claude account page (signing in there turns it on); sim otherwise.
# sim here always keeps sim. claude here locks that switch on: remove it to control the switch from the Account page.
HQ_RUNNER=

# Option A: API key, pay per token. https://console.anthropic.com/settings/keys. A key wins over the login.
# Option B: leave this empty and sign in with your Claude account on HQ's Claude account page
# (#/account), or use the Claude Code login already on this machine. Spends that subscription's usage window.
# Anthropic's SDK docs say third-party products may not ship on claude.ai login. Personal use
# on your own machine is your call. Do not distribute the app configured this way.
ANTHROPIC_API_KEY=

# Model for every desk. Defaults to claude-opus-5. On a subscription, Opus burns the usage
# window fastest; switch to claude-sonnet-5 if agents keep stalling on limits.
HQ_MODEL=claude-opus-5

# HQ's limits (turns, budgets, run times, tool calls, HQ_CONCURRENCY, huddles, QA fixes, desk chat) can also be
# changed on HQ's Accounts page (#/account), under Limits, with no restart. A value set there wins over this file;
# Reset there goes back to this file, or to HQ's default. Times here are in milliseconds; the page shows minutes.

# Guard rails per run. The budget is the SDK's cost estimate; a small email task on Opus 5 lands
# around $1, so 3 leaves room. On a subscription it is a runaway-loop stop, not a charge.
HQ_MAX_BUDGET_USD=3
HQ_MAX_TURNS=40
# Chat replies and huddle turns: a shorter leash.
# HQ_MSG_MAX_TURNS=12
# HQ_MSG_MAX_BUDGET_USD=1
# GPT desks are capped by tool calls, not dollars: ticket runs (and QA checks, huddle turns), chat replies, planning.
# HQ_GPT_MAX_TOOL_CALLS=80
# HQ_GPT_MSG_MAX_TOOL_CALLS=24
# HQ_GPT_PLAN_MAX_TOOL_CALLS=40
# A run stops when it goes quiet, not for being busy: no message from Claude for HQ_RUN_IDLE_MS (8 min),
# or HQ_TOOL_IDLE_MS (20 min) while a tool call waits for its result. HQ_RUN_TIMEOUT_MS caps the whole run (40 min).
HQ_RUN_IDLE_MS=480000
HQ_TOOL_IDLE_MS=1200000
HQ_RUN_TIMEOUT_MS=2400000
# A connection's tool call that never answers fails after this, so the desk can carry on. 0 leaves it to Claude Code.
HQ_MCP_TOOL_TIMEOUT_MS=900000
# 1 = log every message from Claude with the gap since the one before (to tune the limits above).
HQ_DEBUG_SDK=0

# Autopilot and Pause: how often HQ checks for held work, Autopilot picks and goal planning (live mode).
HQ_AUTO_SWEEP_MS=60000
# Goal mode: room for one planning run of the lead.
HQ_PLAN_MAX_TURNS=20
HQ_PLAN_MAX_BUDGET_USD=1.5

# Minutes a desk's session counts as still cached (HQ asks Claude for the 1-hour cache).
HQ_SESSION_CACHE_MIN=55
# Tokens a session may grow past its fresh-start size before HQ starts it fresh once its cache has gone cold.
HQ_FRESH_SESSION_TOKENS=40000

# How many agents may run at the same time.
HQ_CONCURRENCY=2

# 1 = let agents use WebSearch / WebFetch (Riley and Maria benefit). Off by default.
HQ_WEB=0

# Huddles a project can start per day. Each one takes several desk runs. 0 turns huddles off.
HQ_HUDDLES_PER_DAY=5
# Dev-team projects: fixes after a QA fail before the ticket comes to you instead.
HQ_QA_MAX_FIXES=2
# Desk chat: desk-to-desk messages a thread takes before it pauses, and per project per day.
# HQ_CHAT_HOP_LIMIT=6
# HQ_CHAT_DAILY_RUNS=30

# Skills: the Python that runs skill scripts. Empty = python on Windows, python3 elsewhere.
# A full path, or a name HQ looks up in PATH (never in a desk's folder). A relative path is refused.
HQ_PYTHON=
# Skills: the git that fetches skills, 2.45.2 or newer. Empty = git from PATH. A full path or a name, as above.
HQ_GIT=
# Skills: how long one skill script may run before HQ stops it.
HQ_SKILL_TIMEOUT_MS=60000
